"Exatas: %@ · Possíveis: %@" = "Exact: %@ · Possible: %@";

"Resultado da consulta" = "Scan results";

"Possíveis duplicatas" = "Possible duplicates";

"Nenhuma cópia idêntica encontrada. Confira também a aba Possíveis duplicatas." = "No identical copy found. Also check the Possible duplicates tab.";

"Metadados semelhantes sugerem variantes, não arquivos idênticos. Compare as imagens ampliadas e escolha uma cópia para manter apenas nos pares que reconhecer como duplicatas. Nenhum par começa selecionado." = "Similar metadata suggests variants, not identical files. Compare the enlarged images and choose a copy to keep only for pairs you recognize as duplicates. No pair starts selected.";

"Revisar possíveis duplicatas" = "Review possible duplicates";

"Comparar ampliado" = "Enlarge comparison";

"Desmarcar par" = "Deselect pair";

